rules_version = '2';

// Firestore security rules.
//
// Firestore is default-deny: any path without a matching `allow` is rejected
// with PERMISSION_DENIED, and `create`/`update`/`delete` are separate
// operations. The rules that shipped with the boilerplate only covered
// `organizations`, `invites`, part of `teams` and a public read on `users` —
// none of the collections the browser actually writes to (retrospectives,
// board, comments, groups, timer, actions, custom templates, notifications).
// The working rule set lived in the hosted project rather than in the repo, so
// a fresh self-hosted install could not create a retrospective at all.
//
// The model here is deliberately simple, because it matches how the app is
// actually used — a team tool where everyone in an organization is a
// colleague:
//
//   * Everything under /organizations/{organizationId} is readable and
//     writable by the members of that organization, and by nobody else.
//   * Membership is the `members` map on the organization document. That map
//     can only be changed by the Admin SDK (see `canUpdateOrganization`), so a
//     client cannot add itself to an organization.
//   * Joining — accepting an invite, or joining a board by code — happens
//     server side through the Admin SDK, which bypasses these rules and adds
//     the user to `members` first. So every client write happens as a member.
//   * Anonymous users are members like any other, which matters because
//     signing in anonymously is the primary way into this app.
//
// Role checks are left to the application. Within an organization the rules do
// not distinguish member from admin: the helpers below are kept so a
// self-hoster who needs a stricter split has something to build on.
//
// Reference data that the marketing pages and the signed-out demo board read
// (`users`, `tags`, `icebreakers`, `bulletPlans`, `demo`) is public, and only
// `demo` is writable. Application settings in `rules` are readable per section
// but never wholesale, because that collection also holds the AI key — see the
// block below. `emails` is touched exclusively by the Admin SDK and stays
// denied to clients.
service cloud.firestore {
  match /databases/{database}/documents {
    function userId() {
      return request.auth.uid;
    }

    // [READ] Data that exists on the Firestore document
    function existingData() {
      return resource.data;
    }

    function existingDataId() {
      return 'id' in resource ? resource.id : null;
    }

    function isSignedIn() {
      return userId() != null;
    }

    // [WRITE] Data that is sent to a Firestore document
    function incomingData() {
      return request.resource.data;
    }

    // use this function to prevent from writing certain fields
    // to the document, such as sensitive data (permissions, etc.)
    // create: if fieldsNotInCreateAction(["permissions"]);
    function fieldsNotInCreateAction(fields) {
      return !(request.resource.data.keys().hasAll(fields));
    }

    function fieldsNotInUpdateAction(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny
      (fields);
    }

    function getUserRole(organization, userId) {
      let members = organization.data.members;
      let member = members[userId];

      return member != null ? member.role : -1;
    }

    function getUser(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function getCurrentUser() {
      return getUser(userId());
    }

    function isAdmin(organizationId) {
      let organization = getOrganization(organizationId);
      let role = getUserRole(organization, userId());

      // if user is Admin = 1, or Owner = 2
      // please update this according your app's domain

      return role >= 1;
    }

    function getOrganization(organization) {
      return get(/databases/$(database)/documents/organizations/$(organization));
    }

    function userIsMemberByOrganizationId(organizationId) {
      let organization = getOrganization(organizationId);

      return userIsMember(organization);
    }

    function userIsMember(organization) {
      let role = getUserRole(organization, userId());

      return role >= 0;
    }

    function canUpdateOrganization(organizationId) {
      let isMember = userIsMemberByOrganizationId(organizationId);

      // `members` is the source of truth for who may read and write anything
      // in this organization, so only the Admin SDK gets to change it —
      // otherwise a member could add themselves to somebody else's
      // organization. Everything else on the document (name, logo, AI
      // counters) is fair game for a member.
      let noDisallowedFields = fieldsNotInUpdateAction(['members']);

      return isMember && noDisallowedFields;
    }

    function canCreateOrganization() {
      // the creator is added to `members` afterwards, server side
      return isSignedIn() && fieldsNotInCreateAction(['members']);
    }

    match /organizations/{organizationId} {
      allow create: if canCreateOrganization();
      allow read: if userId() in existingData().members;
      allow update: if canUpdateOrganization(organizationId);

      // Retrospectives, boards, comments, groups, votes, actions, timers,
      // teams, custom templates, invites, notifications — the whole
      // organization subtree belongs to its members.
      //
      // The leading `{subcollection}` segment matters: it is what keeps this
      // rule off the organization document itself. `**` matches zero or more
      // segments, so a bare `match /{documents=**}` here would also match the
      // organization document and union itself with the `update` rule above —
      // which would let any member rewrite the `members` map and add or
      // promote whoever they liked. Requiring a subcollection name first makes
      // the shortest path this can match `{subcollection}/{docId}`.
      //
      // This costs one `get()` on the organization document per operation.
      // Rules evaluation caches it for the duration of a request and it is
      // well within the free tier, but it is the reason to authorize the
      // subtree in one place rather than per collection.
      match /{subcollection}/{documents=**} {
        allow read, write: if userIsMemberByOrganizationId(organizationId);
      }
    }

    // Board members are shown by name and avatar, which means reading the
    // profile of somebody who is not in your organization. Profiles are
    // written server side only.
    match /users/{user} {
      allow read: if true;
    }

    // Reference data, read on public pages and on the signed-out demo board.
    // Seeded by the self-hoster; not writable from a browser.
    match /tags/{tag} {
      allow read: if true;
    }

    match /icebreakers/{icebreaker} {
      allow read: if true;
    }

    match /bulletPlans/{document=**} {
      allow read: if true;
    }

    // Application settings, one document per section (`organizations`,
    // `boards`, `retrospectives`, `users`). `useFetchRules` reads these from
    // the browser on nearly every page, including the signed-out demo board,
    // and merges them over the permissive defaults in
    // `src/lib/rules/defaults.ts`. A denial here does not quietly fall back to
    // those defaults: reactfire throws it into the page, and the whole route
    // dies with "No matching allow statements".
    //
    // The catch is that this collection also holds `rules/ai-config`, which
    // stores the self-hoster's own AI provider key in plain text — this is a
    // bring-your-own-key build, so that key is the one real secret in the
    // database. A blanket read here would hand it to every visitor.
    //
    // So a document is readable only if it carries a `section` field, which
    // `ai-config` does not. That also refuses an unfiltered read of the whole
    // collection, because `ai-config` would be in the result set: a query has
    // to be narrowed to a section to be allowed at all, which is exactly what
    // `useFetchRules` does.
    //
    // Excluding `ai-config` by document id instead does not work, and is worth
    // knowing before reaching for it: a `list` targets the collection, so the
    // `{ruleId}` wildcard is unbound and any comparison against it is
    // indeterminate — `allow read: if ruleId != 'ai-config'` denies every
    // query, including the ones this app depends on. The field check is
    // therefore the whole guard, so keep the invariant it rests on: anything
    // secret belongs in a document WITHOUT a `section` field.
    //
    // Writes are Admin SDK only — the admin UI and the cron jobs.
    match /rules/{ruleId} {
      allow read: if 'section' in resource.data;
    }

    // The demo board is a single shared sandbox that anybody can play with
    // without signing in — that is the point of it, so it has to accept
    // unauthenticated writes. Nothing real lives here: it is one fixed
    // `demo/demo` document plus its comments, and it is not linked to any
    // organization. If you self-host and would rather not expose a writable
    // document, delete the `/demo` routes and drop this block.
    match /demo/{document=**} {
      allow read, write: if true;
    }
  }
}
