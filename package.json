{
  "name": "retroteam-oss",
  "version": "1.0.0",
  "description": "RetroTeam OSS — a self-hostable, open-source online retrospective tool built on Next.js and Firebase.",
  "sideEffects": false,
  "browserslist": [
    ">0.3%",
    "not ie 11",
    "not dead",
    "not op_mini all"
  ],
  "scripts": {
    "analyze": "ANALYZE=true npm run build",
    "dev": "next dev",
    "build": "next build",
    "build:test": "NODE_ENV=test next build",
    "dev:test": "NODE_ENV=test next dev",
    "postbuild": "npm run sitemap",
    "sitemap": "next-sitemap",
    "start": "next start",
    "start:test": "NODE_ENV=test next start",
    "typecheck": "tsc",
    "lint": "next lint",
    "format": "prettier --write src/**/*.{ts,tsx}",
    "healthcheck": "npm run lint && npm run typecheck",
    "firebase:emulators:start": "firebase emulators:start --only auth,firestore,storage --project demo-retroteam",
    "firebase:emulators:export": "firebase emulators:export --project demo-retroteam ./.emulator-data",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "cypress": "NODE_ENV=test cypress open",
    "cypress:headless": "NODE_ENV=test cypress run",
    "killports": "sh scripts/kill-ports.sh",
    "firebaseCollections:import": "node scripts/migrate-dev-prod-collections"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.46",
    "@ai-sdk/google": "^3.0.30",
    "@ai-sdk/openai": "^3.0.31",
    "@ai-sdk/openai-compatible": "^2.0.30",
    "@babel/runtime": "^7.25.6",
    "@dnd-kit/core": "^6.0.8",
    "@dnd-kit/sortable": "^7.0.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@heroicons/react": "^2.0.18",
    "@mdx-js/mdx": "^2.3.0",
    "@mui/material": "^6.4.0",
    "@mui/x-date-pickers": "^7.23.6",
    "@radix-ui/react-avatar": "^1.0.3",
    "@radix-ui/react-collapsible": "^1.0.3",
    "@radix-ui/react-dialog": "^1.0.4",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-popover": "1.0.6",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tooltip": "^1.0.6",
    "@react-email/body": "^0.0.3",
    "@react-email/button": "^0.0.10",
    "@react-email/column": "^0.0.7",
    "@react-email/head": "^0.0.5",
    "@react-email/html": "^0.0.4",
    "@react-email/preview": "^0.0.6",
    "@react-email/render": "^0.0.7",
    "@react-email/section": "^0.0.9",
    "@react-email/text": "^0.0.5",
    "@tailwindcss/forms": "^0.5.6",
    "@tanstack/react-table": "^8.9.3",
    "@tremor/react": "^3.8.2",
    "@types/js-cookie": "^3.0.3",
    "ai": "^6.0.97",
    "axios": "^1.7.9",
    "clsx": "^2.0.0",
    "csrf": "^3.1.0",
    "cva": "npm:class-variance-authority@^0.7.0",
    "date-fns": "2.30.0",
    "dayjs": "^1.11.13",
    "fast-xml-parser": "^5.2.2",
    "feed": "^4.2.2",
    "firebase": "^9.23.0",
    "firebase-admin": "^11.10.1",
    "firebase-functions": "^6.1.0",
    "flowbite": "^1.8.1",
    "flowbite-react": "^0.6.0",
    "gpt-tokenizer": "^2.2.1",
    "heroicons": "2.0.18",
    "i18next": "^23.4.5",
    "iron-session": "^8.0.4",
    "js-cookie": "^3.0.5",
    "lodash": "^4.17.21",
    "next": "^15.5.12",
    "next-i18next": "^14.0.0",
    "nodemailer": "^6.9.4",
    "nookies": "^2.5.2",
    "pino": "^8.15.0",
