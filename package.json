    "@types/lodash": "^4.17.7",
    "@types/node": "^20.5.3",
    "@types/nodemailer": "^6.4.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^9.0.3",
    "@typescript-eslint/eslint-plugin": "^5.61.0",
    "@typescript-eslint/parser": "^5.61.0",
    "autoprefixer": "^10.4.15",
    "cypress": "12.17.3",
    "dotenv": "^16.3.1",
    "eslint": "^8.47.0",
    "eslint-config-next": "^15.5.12",
    "firebase-tools": "^12.5.0",
    "gray-matter": "4.0.3",
    "next-sitemap": "^4.2.2",
    "pino-pretty": "^10.2.0",
    "postcss": "^8.4.28",
    "prettier": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.5.3",
    "rehype-autolink-headings": "^6.1.1",
    "rehype-highlight": "^6.0.0",
    "rehype-sanitize": "^5.0.1",
    "rehype-slug": "^5.1.0",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.1.6"
  },
  "optionalDependencies": {
    "recharts": "^2.7.3"
  },
  "engines": {
    "node": "22.x"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/willysharp5/RetroTeam-OSS.git"
  }
}
