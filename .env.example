# ---------------------------------------------------------------------------
# RetroTeam OSS — environment variables
#
# Copy this file to `.env.local` and fill in the values you need:
#
#   cp .env.example .env.local
#
# `.env.local` is gitignored. NEVER commit a file that contains real values.
#
# Only the variables under "REQUIRED" are needed to boot the app. Everything
# else is optional — the app degrades gracefully without it. There is no paid
# tier and no feature flag gating: anything that needs a third-party key is
# bring-your-own-key, and you supply it here (or, for AI, in the app UI).
# ---------------------------------------------------------------------------


# ===========================================================================
# REQUIRED — site
# ===========================================================================

# The public origin the app is served from, with no trailing slash. Used for
# canonical URLs, invite links and email links.
# Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=


# ===========================================================================
# REQUIRED — Firebase (client SDK)
#
# Firebase Console → Project settings → General → "Your apps" → Web app →
# "SDK setup and configuration" → Config. These values are public by design:
# they end up in the browser bundle. Firestore Security Rules
# (`firestore.rules`) are what actually protect your data.
#
# Using the local emulator suite? Set NEXT_PUBLIC_EMULATOR=true below and put
# any non-empty placeholder here (e.g. `demo-retroteam` for the project id) —
# the emulators do not validate them.
# ===========================================================================

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional. Only used if you enable Google Analytics for Firebase.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=


# ===========================================================================
# REQUIRED — Firebase Admin SDK (server side)
#
# Firebase Console → Project settings → Service accounts →
# "Generate new private key". Use EITHER the two variables below OR
# GOOGLE_APPLICATION_CREDENTIALS.
#
# Not needed when running against the emulator suite.
# ===========================================================================

# The service account's `client_email` from the downloaded JSON.
FIREBASE_CLIENT_EMAIL=

# The service account's `private_key` from the downloaded JSON. Keep the
# literal \n escapes and wrap the whole thing in double quotes, e.g.
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# Alternative to the two variables above: an absolute path to the service
# account JSON file on disk. Leave empty if you set the two variables.
GOOGLE_APPLICATION_CREDENTIALS=


# ===========================================================================
# REQUIRED — encryption secret
#
# Used to encrypt/decrypt values at rest (see src/core/generic/crypto.ts) and
# to sign admin impersonation-restore tokens. Any long random string.
# Generate one with:  openssl rand -hex 32
# ===========================================================================

SECRET_KEY=


# ===========================================================================
# Local development with the Firebase Emulator Suite
#
# The zero-cost, zero-signup way to run the app. Set NEXT_PUBLIC_EMULATOR to
# `true`, then `npm run firebase:emulators:start` in one terminal and
# `npm run dev` in another. See the README.
# ===========================================================================

# `true` to point Auth, Firestore and Storage at the local emulators.
NEXT_PUBLIC_EMULATOR=false

# Emulator host. Defaults are fine for a standard local setup.
NEXT_PUBLIC_EMULATOR_HOST=localhost
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=localhost
NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT=8080
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_PORT=9099


# ===========================================================================
# OPTIONAL — AI features (bring your own key)
#
# Powers automatic card grouping, suggested action items, pattern analysis and
# the analytics insights. Without a key those buttons show a notice telling you
# to add one — everything else in the app works normally.
#
# You can set the key here, or paste it in the app at Admin → AI Settings
# (which also lets you pick the provider, model and edit every prompt). The
# app never ships a key of its own and never calls a hosted service on your
# behalf.
#
# Where to get a key:
#   Anthropic  https://console.anthropic.com/settings/keys
#   OpenAI     https://platform.openai.com/api-keys
#   Google     https://aistudio.google.com/apikey
#   Or point the "openai-compatible" provider at a local Ollama / LM Studio /
#   vLLM server, which needs no key at all — just a base URL.
#
# Defaults if you set nothing in the admin UI: provider `anthropic`,
# model `claude-sonnet-5`.
# ===========================================================================

AI_API_KEY=


# ===========================================================================
# OPTIONAL — outbound email over SMTP
#
# Used for invitations, retrospective summaries and member notifications.
# Leave every variable empty and the app still runs: emails are logged to the
# server console (including their links) instead of being sent, and nothing
# throws.
#
# You are not locked out without it:
#   * Password resets and email verification are sent by Firebase Auth itself,
#     not by SMTP, so they keep working.
#   * Every invite link can be copied straight from the UI — organization
#     members, teams and boards all have a "copy invite link" action.
#
# Works with any SMTP provider, including a free tier, your own Postfix, or a
# local catch-all like MailHog / Mailpit (host localhost, port 1025).
# ===========================================================================

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# `true` for implicit TLS. Leave empty to infer it: secure when port is 465,
# STARTTLS otherwise.
SMTP_SECURE=

# The From header, e.g. RetroTeam <retro@example.com>. Falls back to
# NEXT_PUBLIC_CONTACT_EMAIL when empty.
EMAIL_SENDER=

# Shown as the app's contact address, and used as the fallback SMTP sender.
NEXT_PUBLIC_CONTACT_EMAIL=


# ===========================================================================
# OPTIONAL — scheduled jobs
#
# Two cron endpoints finish overdue retrospectives and expire anonymous
# accounts. They reject every request unless CRON_SECRET is set and the caller
# sends `Authorization: Bearer <CRON_SECRET>`. Leave it empty to disable them.
#
#   POST /api/cron/finish-retrospectives
#   POST /api/cron/disable-anonymous-users
#
# On Vercel these are wired up in vercel.json. Anywhere else, call them from
# your own scheduler. Generate a secret with:  openssl rand -hex 32
# ===========================================================================

CRON_SECRET=


# ===========================================================================
# OPTIONAL — behaviour and branding
# ===========================================================================

# `true` to require users to verify their email before using the app.
NEXT_PUBLIC_REQUIRE_EMAIL_VERIFICATION=false

# Default locale for translations. Only `en` ships in public/locales.
DEFAULT_LOCALE=en

# Where the logo on the auth pages links to.
NEXT_PUBLIC_AUTH_LOGO_HREF=/

# Where the buttons on the 404 page link to.
NEXT_PUBLIC_404_HOME_BUTTON_HREF=/
NEXT_PUBLIC_404_CONTACT_BUTTON_HREF=/


# ===========================================================================
# OPTIONAL — Firebase App Check
#
# Hardens the API against abuse. Firebase Console → App Check → reCAPTCHA v3.
# Leave empty and App Check is skipped entirely.
# ===========================================================================

NEXT_PUBLIC_APPCHECK_KEY=

# A debug token for local development, so App Check does not block localhost.
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=


# ===========================================================================
# OPTIONAL — Google Analytics
#
# Off unless you set these. No analytics script is loaded when they are empty,
# so a default self-hosted install sends nothing to any third party.
# ===========================================================================

NEXT_PUBLIC_GOOGLE_ANALYTICS_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_TAG_ID=


# ===========================================================================
# OPTIONAL — end-to-end tests
#
# Only needed to run the Cypress suite. CSRF_MOCK_TOKEN lets the tests bypass
# CSRF checks and must NEVER be set in production.
# ===========================================================================

CSRF_MOCK_TOKEN=
USER_EMAIL=
USER_PASSWORD=
